{
  "name": "blogs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "cross-env NEXT_PUBLIC_ENV=development next dev --webpack -p 4000",
    "build:dev": "cross-env NEXT_PUBLIC_ENV=development next build",
    "build:test": "cross-env NEXT_PUBLIC_ENV=test next build",
    "build:prod": "cross-env NEXT_PUBLIC_ENV=production next build && node scripts/fix-standalone-structure.mjs",
    "start": "cross-env NEXT_PUBLIC_ENV=production next start -p 3000",
    "check:case": "node scripts/check-path-case.mjs",
    "ci": "npm run lint && npm run check:case && npm run build:test",
    "test": "npm run ci",
    "start:test": "cross-env NEXT_PUBLIC_ENV=test next start -p 5000",
    "test:dev": "cross-env NEXT_PUBLIC_ENV=test next dev --webpack -p 5000",
    "lint": "eslint"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.5",
    "axios": "^1.13.5",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "next": "16.2.6",
    "prop-types": "^15.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6"
  }
}
